{
  "name": "dojo-explorer-v2",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Static, synthetic-only Dojo results explorer v2 (no backend, no network).",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:v2": "node --test src/v2/*.test.mjs",
    "test:ui": "vitest run",
    "test": "npm run test:v2 && npm run test:ui",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-is": "^19.2.0",
    "recharts": "^3.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "vite": "^7.0.0",
    "vitest": "5.0.5"
  }
}
